# ============================================================
# IMPACT BRIDGE — Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env or secret credentials to Git!
# ============================================================

# Server Port (Default: 5000)
PORT=5000

# Backend JWT Secret Key
JWT_SECRET=impact_bridge_super_secure_jwt_secret_2026_production

# Google OAuth 2.0 Web Client Credentials
# Create or obtain these from the Google Cloud Console (APIs & Services > Credentials):
# 1. Authorized JavaScript origins: http://localhost:5173, http://localhost:5000
# 2. Authorized redirect URIs: http://localhost:5173, http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
